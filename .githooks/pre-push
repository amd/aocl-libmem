#!/bin/bash

# Git pre-push hook - runs locally before push
# Validates: JIRA ID, spell check, indentation, builds all combinations

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=== Running Pre-Push Checks ===${NC}\n"

# Get commit messages being pushed
remote="$1"
url="$2"

CHECKS_FAILED=0

# Read commits being pushed
while read local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch - find merge base with remote branches
        merge_base=$(git merge-base "$local_sha" origin/amd-main 2>/dev/null || git merge-base "$local_sha" origin/HEAD 2>/dev/null || echo "")
        if [ -n "$merge_base" ]; then
            range="${merge_base}..${local_sha}"
        else
            # Fallback: just check the current commit
            range="${local_sha}^..${local_sha}"
        fi
    else
        range="${remote_sha}..${local_sha}"
    fi
    
    # Check if pushing to external/public repo (block .githooks/)
    # Public: github.com/amd/aocl-libmem
    # Internal: github.com/AMD-AOCL/aocl-libmem (allowed)
    REMOTE_URL=$(git remote get-url "$remote" 2>/dev/null || echo "")
    if [[ "$REMOTE_URL" =~ github\.com/amd/aocl-libmem ]]; then
        echo -e "${YELLOW}⚠ Detected push to PUBLIC GitHub repository (github.com/amd/aocl-libmem)${NC}"
        BLOCKED_FILES=$(git diff --name-only "$range" | grep -E '^\.githooks/|^setup-dev-hooks\.sh')
        if [ -n "$BLOCKED_FILES" ]; then
            echo -e "${RED}✗ BLOCKED: Attempting to push internal files to public repo:${NC}"
            echo "$BLOCKED_FILES" | sed 's/^/  /'
            echo -e "${RED}These files are for internal AMD use only and must not be pushed to github.com/amd/${NC}\n"
            exit 1
        fi
    fi
    
    echo -e "${YELLOW}[1/4] Checking JIRA Ticket IDs...${NC}"
    # Check all commits for JIRA IDs in exact format: AMD-Internal: [CPUPL-1234]
    JIRA_PATTERN='AMD-Internal: \[[A-Z]+-[0-9]+\]'
    JIRA_ERRORS=""
    
    # Get each commit in the range
    while read -r commit_sha; do
        # Get the full commit message (subject + body combined)
        COMMIT_MSG=$(git log -1 --pretty=%B "$commit_sha" | tr '\n' ' ' | sed 's/  */ /g')
        
        # Skip empty commits
        if [ -z "$COMMIT_MSG" ] || [ "$COMMIT_MSG" = " " ]; then
            continue
        fi
        
        # Check if JIRA ID exists anywhere in the commit message
        if ! echo "$COMMIT_MSG" | grep -qE "$JIRA_PATTERN"; then
            COMMIT_SUBJECT=$(git log -1 --pretty=%s "$commit_sha")
            JIRA_ERRORS="${JIRA_ERRORS}\n  ${commit_sha:0:8}: ${COMMIT_SUBJECT}"
        fi
    done < <(git rev-list "$range")
    
    if [ -n "$JIRA_ERRORS" ]; then
        echo -e "${RED}✗ JIRA ID missing or incorrect format in commits:${JIRA_ERRORS}${NC}"
        echo -e "${RED}  Required format: AMD-Internal: [CPUPL-1234] Your commit message${NC}\n"
        exit 1
    else
        echo -e "${GREEN}✓ JIRA ID check passed${NC}\n"
    fi
    
    # Get list of all files changed in commits being pushed (not just diff from remote)
    # This ensures we check files even when only commit message is amended
    CHANGED_FILES=$(git log --name-only --pretty=format: "$range" | sort -u | grep -E '\.(c|h)$' || true)
    
    if [ -z "$CHANGED_FILES" ]; then
        echo -e "${YELLOW}No C/H files changed, skipping spell/indentation checks${NC}\n"
    else
        echo -e "${YELLOW}[2/4] Running Spell Check on changed lines (diff only)...${NC}"
        
        SPELL_ERRORS=""
        DICT_FILE=""
        
        # Try to find or create a dictionary
        if [ -f "/usr/share/dict/words" ]; then
            DICT_FILE="/usr/share/dict/words"
        elif [ -f "$HOME/.githooks_dict" ]; then
            DICT_FILE="$HOME/.githooks_dict"
        else
            # Create dictionary from available system resources
            echo -e "${BLUE}  Creating dictionary from system resources (one-time setup)...${NC}"
            TEMP_DICT="$HOME/.githooks_dict"
            
            # Try groff common words first (small but guaranteed)
            if [ -f "/usr/share/groff/current/eign" ]; then
                cat /usr/share/groff/current/eign > "$TEMP_DICT"
            fi
            
            # Add words from man pages if available (this gives good English words)
            if command -v man &> /dev/null && [ -d "/usr/share/man/man1" ]; then
                zcat /usr/share/man/man1/*.gz 2>/dev/null | grep -oE '\b[a-zA-Z]{3,}\b' | sort -u >> "$TEMP_DICT"
            fi
            
            # Add technical terms from GCC libraries (programming constants, CPU features)
            if [ -d "/usr/lib/gcc" ]; then
                grep -rPho '\b[A-Z0-9_]{3,}\b' /usr/lib/gcc/ 2>/dev/null | sort -u >> "$TEMP_DICT"
            fi
            
            if [ -s "$TEMP_DICT" ]; then
                sort -u "$TEMP_DICT" -o "$TEMP_DICT"
                DICT_FILE="$TEMP_DICT"
                echo -e "${GREEN}  Dictionary created at $DICT_FILE${NC}"
            fi
        fi
        
        for file in $CHANGED_FILES; do
            if [ -f "$file" ]; then
                # Extract added lines with actual file line numbers from diff hunk headers
                DIFF_NUMBERED=""
                _current_ln=0
                while IFS= read -r _diff_line; do
                    if [[ "$_diff_line" =~ ^@@.*\+([0-9]+)(,([0-9]+))?.* ]]; then
                        _current_ln=${BASH_REMATCH[1]}
                    elif [[ "$_diff_line" == +* ]] && [[ "$_diff_line" != +++* ]]; then
                        DIFF_NUMBERED="${DIFF_NUMBERED}${_current_ln}:${_diff_line:1}"$'\n'
                        ((_current_ln++)) || true
                    fi
                done < <(git diff -U0 "$range" -- "$file")

                DIFF_ADDED=$(echo "$DIFF_NUMBERED" | sed 's/^[0-9]*://')
                
                if [ -z "$DIFF_ADDED" ]; then
                    continue
                fi
                
                if [ -n "$DICT_FILE" ] && [ -f "$DICT_FILE" ]; then
                    COMMENT_LINES=$(echo "$DIFF_ADDED" | grep -E '^\s*(//|/\*|\*|#)' | grep -v -E '^\s*#\s*(include|define|if|ifdef|ifndef|endif|pragma)' || true)
                    WORDS=$(echo "$COMMENT_LINES" | grep -oE '\b[a-zA-Z]{4,}\b' | sort -u || true)
                    
                    for word in $WORDS; do
                        if echo "$word" | grep -qE '^[A-Z]{2,4}$|^[A-Z]+_[A-Z_]+$'; then
                            continue
                        fi
                        
                        word_lower=$(echo "$word" | tr '[:upper:]' '[:lower:]')
                        
                        if ! grep -qixF "$word_lower" "$DICT_FILE" && ! grep -qixF "$word" "$DICT_FILE"; then
                            LINE_NUM=$(echo "$DIFF_NUMBERED" | grep "\b$word\b" | head -1 | cut -d: -f1)
                            SPELL_ERRORS="${SPELL_ERRORS}$file:$LINE_NUM: '$word' (in comment)\n"
                        fi
                    done
                    
                    ALPHANUM=$(echo "$COMMENT_LINES" | grep -oE '\b[a-z]+[0-9]+[a-z0-9]*\b' | sort -u || true)
                    for word in $ALPHANUM; do
                        if echo "$word" | grep -qE '^[a-z]+[0-9]$'; then
                            continue
                        fi
                        LINE_NUM=$(echo "$DIFF_NUMBERED" | grep "\b$word\b" | head -1 | cut -d: -f1)
                        SPELL_ERRORS="${SPELL_ERRORS}$file:$LINE_NUM: '$word' (check spelling)\n"
                    done
                else
                    # Fallback: pattern-based checking only on changed lines
                    MIXED_CASE=$(echo "$DIFF_ADDED" | grep -n -E '\b[A-Z][a-z]{2,}[a-z][A-Z][a-zA-Z]*\b' 2>/dev/null | \
                                grep -v -E '[A-Z][a-z]+[A-Z]' || true)
                    if [ -n "$MIXED_CASE" ]; then
                        SPELL_ERRORS="${SPELL_ERRORS}$file: Mixed-case typos in changed lines:\n$MIXED_CASE\n"
                    fi
                fi
            fi
        done
        
        if [ -n "$SPELL_ERRORS" ]; then
            echo -e "${RED}${SPELL_ERRORS}${NC}"
            echo -e "${RED}✗ Spell check found issues${NC}\n"
            exit 1
        else
            echo -e "${GREEN}✓ Spell check passed${NC}\n"
        fi
        
        echo -e "${YELLOW}[3/4] Checking Code Style on changed lines (diff only)...${NC}"
        # Check if clang-format is available
        if ! command -v clang-format &> /dev/null; then
            echo -e "${YELLOW}⚠ clang-format not found, skipping style check${NC}\n"
        else
            # Define style configuration inline
            CLANG_STYLE='{
                BasedOnStyle: LLVM,
                IndentWidth: 4,
                ColumnLimit: 120,
                PointerAlignment: Right,
                SpaceBeforeParens: ControlStatements,
                SpaceAfterCStyleCast: true,
                BreakBeforeBraces: Custom,
                BraceWrapping: {
                    AfterFunction: true,
                    AfterControlStatement: Always,
                    AfterEnum: false,
                    AfterStruct: false,
                    BeforeElse: true
                },
                AllowShortFunctionsOnASingleLine: None,
                AllowShortIfStatementsOnASingleLine: Never
            }'
            
            INDENT_ERRORS=""
            for file in $CHANGED_FILES; do
                if [ -f "$file" ]; then
                    # Create temp file with current version
                    TEMP_FILE=$(mktemp)
                    cp "$file" "$TEMP_FILE"
                    
                    # Get the diff of changed lines in the push range
                    # Format: @@ -old_start,old_count +new_start,new_count @@
                    git diff -U0 "$range" -- "$file" | grep '^@@' | while read -r line; do
                        # Extract the line range for additions (lines starting with +)
                        NEW_RANGE=$(echo "$line" | sed -n 's/^.*+\([0-9]*\),*\([0-9]*\).*/\1:\2/p')
                        START=$(echo "$NEW_RANGE" | cut -d: -f1)
                        COUNT=$(echo "$NEW_RANGE" | cut -d: -f2)
                        
                        # If count is empty, it's a single line change
                        if [ -z "$COUNT" ] || [ "$COUNT" = "0" ]; then
                            COUNT=1
                        fi
                        
                        # Calculate end line
                        END=$((START + COUNT - 1))
                        
                        # Format only the changed lines in temp file
                        if [ "$START" -gt 0 ]; then
                            clang-format -i --style="$CLANG_STYLE" --lines="$START:$END" "$TEMP_FILE" 2>/dev/null
                        fi
                    done
                    
                    # Check if formatting changed anything
                    if ! diff -q "$file" "$TEMP_FILE" > /dev/null 2>&1; then
                        # Extract line numbers that differ
                        DIFF_LINES=$(diff -U0 "$file" "$TEMP_FILE" 2>/dev/null | \
                        grep "^@@" | sed 's/@@ -\([0-9]*\).*/\1/' | head -20 | tr '\n' ',' | sed 's/,$//')
                        INDENT_ERRORS="${INDENT_ERRORS}\n  $file (changed lines: ${DIFF_LINES})"
                    fi
                    
                    rm -f "$TEMP_FILE"
                fi
            done
            
            if [ -n "$INDENT_ERRORS" ]; then
                echo -e "${RED}✗ Style issues in modified lines:${INDENT_ERRORS}${NC}"
                echo -e "${YELLOW}  Common issues:${NC}"
                echo -e "${YELLOW}    - Braces on new line for functions and control statements${NC}"
                echo -e "${YELLOW}    - Space after cast: (uint8_t *) not (uint8_t*)${NC}"
                echo -e "${YELLOW}    - No space before comma: func(a, b) not func(a ,b)${NC}"
                echo -e "${YELLOW}    - Include order: group system <> and local \"\" headers, sort alphabetically${NC}"
                echo -e "${YELLOW}    - Line length: max 120 characters${NC}"
                echo -e "${YELLOW}  Run: clang-format -i <file> to auto-fix${NC}\n"
                exit 1
            else
                echo -e "${GREEN}✓ Code style check passed (changed lines)${NC}\n"
            fi
        fi
    fi
    
    echo -e "${YELLOW}[4/4] Building All Combinations...${NC}"
    echo -e "${BLUE}This may take several minutes...${NC}\n"
    
    # Build types from nightly script (build verification only, no tests)
    # Format: "compiler:build_type:cmake_flags:label"
    BUILD_CONFIGS=(
        "gcc:Isa_avx512:-D ALMEM_ISA=avx512:GCC ISA AVX512"
        "gcc:Isa_avx2:-D ALMEM_ISA=avx2:GCC ISA AVX2"
        "gcc:Tunable:-D ALMEM_TUNABLES=Y:GCC Tunable"
        "gcc:Native::GCC Native"
        "gcc:Dyn_dis:-D ALMEM_DYN_DISPATCH=Y:GCC Dynamic Dispatch"
        "clang:Isa_avx512:-D ALMEM_ISA=avx512:AOCC ISA AVX512"
        "clang:Isa_avx2:-D ALMEM_ISA=avx2:AOCC ISA AVX2"
        "clang:Tunable:-D ALMEM_TUNABLES=Y:AOCC Tunable"
        "clang:Native::AOCC Native"
        "clang:Dyn_dis:-D ALMEM_DYN_DISPATCH=Y:AOCC Dynamic Dispatch"
    )
    
    for config in "${BUILD_CONFIGS[@]}"; do
        IFS=':' read -r compiler build_type cmake_flags label <<< "$config"
        
        echo -e "${BLUE}  Building: $label${NC}"
        
        BUILD_DIR="build-check-${compiler}-${build_type}"
        rm -rf "$BUILD_DIR"
        
        # Source AOCC environment if using clang
        if [ "$compiler" = "clang" ]; then
            if [ -f /opt/setenv_AOCC.sh ]; then
                source /opt/setenv_AOCC.sh > /dev/null 2>&1
            fi
        fi
        
        # Configure
        CMAKE_CMD="cmake -DCMAKE_C_COMPILER=$compiler -S . -B $BUILD_DIR"
        if [ -n "$cmake_flags" ]; then
            CMAKE_CMD="$CMAKE_CMD $cmake_flags"
        fi
        
        if ! $CMAKE_CMD > /dev/null 2>&1; then
            echo -e "${RED}  ✗ CMake failed for $label${NC}\n"
            rm -rf "$BUILD_DIR"
            exit 1
        fi
        
        # Build
        if ! cmake --build "$BUILD_DIR" -j$(nproc) > /dev/null 2>&1; then
            echo -e "${RED}  ✗ Make failed for $label${NC}\n"
            rm -rf "$BUILD_DIR"
            exit 1
        fi
        
        echo -e "${GREEN}  ✓ $label successful${NC}"
        
        # Cleanup
        rm -rf "$BUILD_DIR"
    done
    
    echo ""
    
done

# All checks passed
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✓ All pre-push checks PASSED${NC}"
echo -e "${GREEN}Push ALLOWED${NC}"
echo -e "${GREEN}========================================${NC}"
echo ""

exit 0