#!/bin/bash

# Git pre-commit hook - auto-formats C/H files before commit

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=== Running Pre-Commit Hook ===${NC}"

# Check if clang-format is available
if ! command -v clang-format &> /dev/null; then
    echo -e "${YELLOW}⚠ clang-format not found, skipping auto-format${NC}"
    exit 0
fi

# Get list of staged C/H files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|h)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${YELLOW}No C/H files staged for commit${NC}"
    exit 0
fi

echo -e "${YELLOW}Checking code formatting for staged files...${NC}"

# Define style configuration (same as pre-push)
CLANG_STYLE='{
    BasedOnStyle: LLVM,
    IndentWidth: 4,
    ColumnLimit: 120,
    PointerAlignment: Right,
    SpaceBeforeParens: ControlStatements,
    SpaceAfterCStyleCast: true,
    BreakBeforeBraces: Custom,
    BraceWrapping: {
        AfterFunction: true,
        AfterControlStatement: Always,
        AfterEnum: false,
        AfterStruct: false,
        BeforeElse: false
    },
    AllowShortFunctionsOnASingleLine: None,
    AllowShortIfStatementsOnASingleLine: Never
}'

FORMATTED=false

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        echo -e "${BLUE}  Checking: $file${NC}"
        
        # Format the file in-place
        clang-format -i --style="$CLANG_STYLE" "$file" 2>/dev/null
        
        # Check if file was modified
        if ! git diff --quiet "$file"; then
            echo -e "${GREEN}    ✓ Formatted and re-staged${NC}"
            # Re-stage the formatted file
            git add "$file"
            FORMATTED=true
        else
            echo -e "${GREEN}    ✓ Already formatted${NC}"
        fi
    fi
done

if [ "$FORMATTED" = true ]; then
    echo -e "\n${GREEN}✓ Auto-formatted files have been re-staged${NC}"
else
    echo -e "\n${GREEN}✓ All files already properly formatted${NC}"
fi

exit 0
